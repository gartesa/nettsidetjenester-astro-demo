---
import { solutions } from "../data/solutions";
import SolutionCard from "./SolutionCard.astro";
---

<section id="soluciones" class="bg-slate-50 py-20">
  <div class="mx-auto max-w-7xl px-6">
    <div class="text-center">
      <h2 class="text-3xl font-bold text-slate-900 sm:text-4xl">Soluciones Digitales</h2>
      <p class="mt-3 text-slate-600">
        Tres soluciones propias, listas para integrarse en tu operativa diaria.
      </p>
    </div>

    <div class="mt-12 grid gap-8 md:grid-cols-3">
      {solutions.map((solution) => <SolutionCard solution={solution} />)}
    </div>
  </div>
</section>
