---
import type { Solution } from "../data/solutions";

interface Props {
  solution: Solution;
}

const { solution } = Astro.props;
---

<div
  class="flex flex-col rounded-2xl border border-slate-200 bg-white p-8 shadow-sm transition hover:-translate-y-1 hover:shadow-xl"
>
  <span
    class="mb-4 inline-block w-fit rounded-full bg-sky-50 px-3 py-1 text-xs font-semibold text-sky-700"
  >
    {solution.tag}
  </span>

  <h3 class="text-2xl font-bold text-slate-900">{solution.name}</h3>

  <p class="mt-3 text-sm leading-relaxed text-slate-600">{solution.description}</p>

  <p class="mt-4 rounded-lg bg-slate-50 p-3 text-sm font-medium text-teal-700">
    {solution.valueProposition}
  </p>

  <ul class="mt-5 flex-1 space-y-2">
    {
      solution.features.map((feature) => (
        <li class="flex items-center gap-2 text-sm text-slate-600">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            class="h-4 w-4 flex-shrink-0 text-teal-500"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M20 6 9 17l-5-5" />
          </svg>
          {feature}
        </li>
      ))
    }
  </ul>

  <a
    href="#contacto"
    class="mt-6 inline-flex items-center justify-center gap-2 rounded-lg bg-slate-900 px-5 py-3 text-sm font-semibold text-white transition hover:bg-indigo-600"
  >
    Solicitar demo / Contratar
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      class="h-4 w-4"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 5l7 7-7 7" />
    </svg>
  </a>
</div>
