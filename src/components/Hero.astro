---
import { company } from "../data/site";
---

<section class="relative overflow-hidden bg-brand-gradient">
  <div class="mx-auto max-w-7xl px-6 py-24 text-center">
    <span
      class="inline-flex items-center gap-2 rounded-full bg-white/15 px-4 py-1.5 text-sm font-medium text-white backdrop-blur"
    >
      {company.tagline}
    </span>

    <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-white sm:text-5xl md:text-6xl">
      Software e Inteligencia Artificial<br class="hidden sm:block" /> aplicada a tu negocio
    </h1>

    <p class="mx-auto mt-6 max-w-2xl text-lg text-white/90">
      Videas IA desarrolla soluciones digitales propias para automatizar la gestión contable,
      evaluar riesgos psicosociales y agilizar la atención a pacientes, con IA aplicada de extremo
      a extremo.
    </p>

    <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
      <a
        href="#soluciones"
        class="rounded-lg bg-white px-8 py-3 text-sm font-semibold text-slate-900 shadow-lg transition hover:bg-slate-100"
      >
        Ver Soluciones Digitales
      </a>
      <a
        href="#contacto"
        class="rounded-lg border border-white/40 px-8 py-3 text-sm font-semibold text-white transition hover:bg-white/10"
      >
        Contactar
      </a>
    </div>
  </div>
</section>
