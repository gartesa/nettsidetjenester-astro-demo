---
import { company } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="bg-slate-900 py-12">
  <div class="mx-auto max-w-7xl px-6">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-start sm:justify-between">
      <div class="flex items-center gap-3">
        <img
          src="/images/logo-videas.jpg"
          alt="Videas IA"
          class="h-10 w-10 rounded-md object-contain"
        />
        <div>
          <p class="text-lg font-bold text-white">{company.name}</p>
          <p class="text-sm text-slate-400">{company.tagline}</p>
        </div>
      </div>

      <div class="text-sm text-slate-400">
        <p>{company.email} · {company.secondaryEmail}</p>
        <p>{company.phone}</p>
      </div>
    </div>

    <div class="mt-6 border-t border-white/10 pt-6 text-xs text-slate-500">
      <p>{company.name} · NIF {company.nif} · {company.address}</p>
      <p class="mt-2">© {year} {company.name}. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>
